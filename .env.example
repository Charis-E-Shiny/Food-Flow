# FoodFlow environment variables (all optional).
# Copy this file to `.env` and fill in your values. Vite loads `.env`,
# NOT this example file. Never commit your real `.env`.

# Map tiles.
# By default FoodFlow uses CARTO Positron tiles — NO API key required.
# To use a keyed provider (sharper, higher rate limits), get a FREE
# MapTiler key at https://cloud.maptiler.com (Account → API keys) and
# set it in your local .env. The map auto-switches to MapTiler when set.
# (Note: VITE_ vars are inlined into the client bundle, so this key is
#  public by design once deployed — use MapTiler domain restrictions.)
VITE_MAPTILER_KEY=
