# FoodFlow environment variables (all optional).
# Copy to `.env` and fill in to override defaults.

# Map tiles.
# By default FoodFlow uses CARTO Positron tiles — NO API key required.
# To use a keyed provider (sharper, higher rate limits), get a FREE
# MapTiler key at https://cloud.maptiler.com (Account → API keys) and
# paste it below. The map auto-switches to MapTiler when this is set.
VITE_MAPTILER_KEY=
